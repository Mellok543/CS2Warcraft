<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Warcraft.Races</AssemblyName>
    <RootNamespace>Warcraft.Races</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" />
    <ProjectReference Include="../Warcraft.Api/Warcraft.Api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../configs/warcraft/races/*.json">
      <Link>defaults/races/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/WarcraftCoreCapability.cs" Link="Shared/WarcraftCoreCapability.cs" />
  </ItemGroup>
</Project>
