<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Warcraft.Database</AssemblyName>
    <RootNamespace>Warcraft.Database</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" />
    <PackageReference Include="MySqlConnector" />
    <ProjectReference Include="../Warcraft.Api/Warcraft.Api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not provided by the CounterStrikeSharp host: ship it next to Warcraft.Database.dll. -->
    <PluginDependency Include="MySqlConnector" NuGetPackageId="MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/WarcraftCoreCapability.cs" Link="Shared/WarcraftCoreCapability.cs" />
  </ItemGroup>
</Project>
